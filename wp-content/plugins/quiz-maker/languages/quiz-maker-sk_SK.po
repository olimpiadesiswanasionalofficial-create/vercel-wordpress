msgstr "Podľa váhy / bodov"

#: ../admin/partials/quizes/actions/partials/quiz-maker-quizes-actions-tab4.php:188
msgid "By weight/points"
msgstr "Podľa hmotnosti/bodov"

#: ../admin/partials/quizes/actions/partials/quiz-maker-quizes-actions-tab4.php:21
msgid "Calculate the score"
msgstr "Vypočítajte skóre"

#: ../admin/partials/quizes/actions/partials/quiz-maker-quizes-actions-tab4.php:22
